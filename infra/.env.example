# =============================================================
# ShopNext — Infrastructure Environment Variables (.env.example)
# Copy to .env and fill in REAL values.
# NEVER commit .env to version control.
# =============================================================

# ---- PostgreSQL ----
POSTGRES_DB=shopnext
POSTGRES_USER=shopnext
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_redis_password_here
REDIS_PORT=6379

# ---- JWT Secrets (generate with: openssl rand -hex 64) ----
JWT_SECRET=CHANGE_ME_64_char_hex_secret
JWT_REFRESH_SECRET=CHANGE_ME_64_char_hex_refresh_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS (comma-separated list of allowed origins) ----
CORS_ORIGIN=http://localhost:3001,http://localhost:80

# ---- Throttler ----
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ---- Ports exposed on host ----
API_PORT=3000
WEB_PORT=3001
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- Frontend build arg ----
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# ---- Node environment ----
NODE_ENV=production
